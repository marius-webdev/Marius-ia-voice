# ========================================================
# Marius Voice AI - Environment Configuration Example
# ========================================================
#
# NOTE IMPORTANTE :
# Marius Voice AI fonctionne avec la clé API Google Gemini
# personnelle de l'utilisateur (configurée directement dans
# l'interface web via l'onglet « Ma clé API Google »).
# Aucune clé partagée ou développeur n'est requise ici.

# Port d'écoute du serveur Node.js / Express (défaut : 3000)
PORT=3000

# Environnement d'exécution ('development' ou 'production')
NODE_ENV=development
